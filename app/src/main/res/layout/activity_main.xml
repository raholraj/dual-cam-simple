<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/backPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Grid overlay -->
    <View
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grid_lines"
        android:visibility="gone" />

    <!-- Front PIP -->
    <FrameLayout
        android:id="@+id/pipContainer"
        android:layout_width="100dp"
        android:layout_height="133dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="110dp"
        android:background="#55FFFFFF"
        android:elevation="6dp"
        android:visibility="gone">

        <TextureView
            android:id="@+id/frontPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="3dp"
            android:background="#99000000"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="FRONT"
            android:textColor="#FFF"
            android:textSize="9sp" />
    </FrameLayout>

    <!-- Top bar: flash + dual + grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/btnFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Flash Off"
            android:textColor="#FFF"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnDual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Dual OFF"
            android:textColor="#FFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#33FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Grid"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="48dp"
        android:padding="4dp"
        android:gravity="center"
        android:text=""
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#99000000"
        android:paddingTop="8dp"
        android:paddingBottom="14dp">

        <!-- PHOTO | VIDEO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/btnModePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="PHOTO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/btnModeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="VIDEO"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Shutter -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnCapture"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/shutterOuter"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_outer" />

                <View
                    android:id="@+id/shutterInner"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_inner_photo" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
